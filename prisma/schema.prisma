// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ------------------------------------------------------
// CORE: TENANT & HIERARQUIA
// ------------------------------------------------------

model Workspace {
  id        Int      @id @default(autoincrement())
  name      String 
  createdAt DateTime @default(now())

  users       WorkspaceUser[]
  greenhouses Greenhouse[]
}

// Tabela pivô para N:N (Múltiplos usuários podem acessar o mesmo Workspace)
model WorkspaceUser {
  id          Int    @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        String @default("MEMBER") // "OWNER", "MEMBER" 

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId]) 
}

model Greenhouse {
  id               Int     @id @default(autoincrement())
  workspaceId      Int
  name             String // Ex: "Estufa Principal", "Freezer 01"
  isPublic         Boolean @default(false) // Define se qualquer um pode ver (Vitrine/Instituição)
  allowExperiments Boolean @default(false) // Define se o frontend deve mostrar a aba de experimentos

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  devices      Device[]
  experimentos Experimento[]
  alerts       Alerts[] // Alertas agora pertencem à estufa, não ao usuário global
  Relatorios   Relatorios[]
}

// ------------------------------------------------------
// ENTIDADES EXISTENTES (REFATORADAS)
// ------------------------------------------------------

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  resetToken        String?
  resetTokenExpires DateTime?
  is2FAEnabled      Boolean   @default(false)
  twoFASecret       String?
  backupCode        String?
  expoPushToken     String?
  webPushToken      Json?

  workspaces    WorkspaceUser[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  experimentos  Experimento[] // Mantido para saber QUEM criou o experimento
  Alerts        Alerts[]
}

model Device {
  id              Int          @id @default(autoincrement())
  mac_address     String?      @unique
  deviceSecret    String
  activationToken String?   @unique
  greenhouseId    Int? // Opcional no início para o caso de um dispositivo ainda não ativado/provisionado

  greenhouse      Greenhouse?   @relation(fields: [greenhouseId], references: [id], onDelete: SetNull)
  temperaturas    Temperatura[] // Agora a temperatura tem uma relação forte com o Device!
  systemLogs      SystemLog[]
}

model Temperatura {
  id        Int      @id @default(autoincrement())
  deviceId  Int // Trocamos a string fraca 'chipId' por uma relação real
  value     Float
  timestamp DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp]) // Index crucial para performance de gráficos e exportações
}

model Experimento {
  id             Int      @id @default(autoincrement())
  greenhouseId   Int // Experimento agora ocorre DENTRO de uma estufa
  userId         Int // Usuário responsável
  nome           String
  objetivo       String?  @db.Text
  temp_min_ideal Float
  temp_max_ideal Float
  data_inicio    DateTime @default(now())
  data_fim       DateTime
  ativo          Boolean  @default(true)
  relatorio      String?  @db.Text

  greenhouse  Greenhouse @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)
  responsavel User       @relation(fields: [userId], references: [id])
}

model Alerts {
  id               Int       @id @default(autoincrement())
  user_id           Int // O "dono" do alerta (quem vai receber o push)
  greenhouseId     Int // Qual estufa esse alerta está vigiando
  temperatura_min  Float?
  temperatura_max  Float?
  hora_inicio      DateTime?
  hora_fim         DateTime?
  criado_em        DateTime  @default(now())
  ativo            Boolean   @default(true)
  notificacaoAtiva Boolean   @default(false)
  nome             String?
  nota             String?

  user          User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  greenhouse    Greenhouse     @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([greenhouseId]) // Acelera o background job (Cron) na hora de buscar os alertas de uma estufa
}

model Relatorios {
  id           Int      @id @default(autoincrement())
  greenhouseId Int // O relatório da IA agora avalia a Estufa inteira, não um chip isolado
  data         DateTime
  relatorio    String
  resumo       String
  criado_em    DateTime @default(now())

  greenhouse Greenhouse @relation(fields: [greenhouseId], references: [id], onDelete: Cascade)

  @@index([greenhouseId, data]) // Crucial para o frontend buscar o histórico rápido
}

model Notification {
  id      Int      @id @default(autoincrement())
  userId  Int
  alertId Int?
  title   String
  content String
  sent_at DateTime @default(now())
  read    Boolean  @default(false)

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alerts? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  deviceId  Int // Trocado de chipId (String) para deviceId (Relação Real)
  level     String // "INFO", "WARN", "ERROR"
  message   String
  timestamp DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}
